PHOTOAPP_DATA_ROOT=/var/lib/photoapp
PHOTOAPP_ALLOWED_ORIGINS=https://studio.example.com
PHOTOAPP_ALLOW_NON_LOOPBACK=true
HOST=0.0.0.0
PORT=3000
WORKER_ID=worker-1

# Store only SHA-256 token digests here; raw bearer tokens belong in a secret manager.
PHOTOAPP_IDENTITIES_JSON=[{"actor_id":"creator-1","role":"CREATOR","token_sha256":"replace-with-64-hex-sha256"},{"actor_id":"reviewer-1","role":"REVIEWER","token_sha256":"replace-with-64-hex-sha256"},{"actor_id":"operator-1","role":"OPERATOR","token_sha256":"replace-with-64-hex-sha256"}]

# Configure at least two independently operated HTTPS render providers.
PHOTOAPP_PROVIDERS_JSON=[{"name":"primary","endpoint":"https://media-primary.example.com/v1/render","token_env":"PRIMARY_MEDIA_TOKEN","daily_quota":1000},{"name":"secondary","endpoint":"https://media-secondary.example.com/v1/render","token_env":"SECONDARY_MEDIA_TOKEN","daily_quota":500}]
PRIMARY_MEDIA_TOKEN=replace-in-secret-manager
SECONDARY_MEDIA_TOKEN=replace-in-secret-manager
